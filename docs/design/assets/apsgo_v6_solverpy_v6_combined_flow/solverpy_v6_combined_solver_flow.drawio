        <mxCell id="9" value="新增组合控制" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="15" width="110" height="30" as="geometry"/>
        </mxCell>
